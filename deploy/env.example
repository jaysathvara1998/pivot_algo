# Copy to ~/.dhan/env (chmod 600) and `source` it, OR run `python3 tools/dhan_token.py setup` once to store these in ~/.dhan/credentials.json.
DHAN_CLIENT_ID=
DHAN_PIN=
DHAN_TOTP_SECRET=
# Telegram (optional): bot token from @BotFather and your chat id (send the bot one message first)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional channel for other members (@name or -100… id; the bot must be an admin with "Post messages"): gets start / ENTRY / EXIT / day stop / session summary only
TELEGRAM_CHANNEL=
